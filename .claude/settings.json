{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(yamllint -s .)",
      "Bash(ansible-lint)",
      "Bash(ansible-playbook --syntax-check:*)",
      "Bash(scripts/policy-test.sh)",
      "Bash(scripts/caddy-routing-test.sh)",
      "Bash(python3 scripts/*-test.py)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
