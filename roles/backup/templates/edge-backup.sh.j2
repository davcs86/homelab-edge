#!/usr/bin/env bash
# {{ ansible_managed }}
# Consistent headscale and happybabytracker snapshots -> tar -> age -> local + rsync to the home backup host.
set -euo pipefail
umask 077

stamp="$(date -u +%Y%m%dT%H%M%SZ)"
vol_root=/var/lib/docker/volumes
out_dir=/var/backups/edge
archive="$out_dir/edge-$stamp.tar.age"
work="$(mktemp -d)"
trap 'rm -rf "$work" "${snap:-}"; if [ -n "${mnt:-}" ]; then rmdir "$mnt"; fi' EXIT
snap="$(mktemp -d)"
chown 10001:10001 "$snap"
mnt="$(mktemp -d /run/edge-backup.XXXXXX)"
chmod 0755 "$mnt"

mkdir -p "$out_dir" "$work/headscale"

# SQLite online backup API: consistent under concurrent writes, WAL included.
sqlite3 "$vol_root/edge_headscale-data/_data/db.sqlite" ".backup '$work/headscale/db.sqlite'"
sqlite3 "$work/headscale/db.sqlite" 'PRAGMA integrity_check;' | grep -qx ok
cp "$vol_root/edge_headscale-data/_data/noise_private.key" "$work/headscale/"
cp "$vol_root/edge_headscale-data/_data/derp_server_private.key" "$work/headscale/"
cp {{ edge_root }}/headscale/config.yaml {{ edge_root }}/headscale/policy.hujson {{ edge_root }}/headscale/extra-records.json "$work/headscale/"

# As the app's uid with no capabilities: a root sqlite3 would create -wal/-shm the API (uid 10001) cannot open.
# uid 10001 cannot traverse Docker's 0710/0701 dirs, so it reaches _data through a private bind mount.
src_dir="$vol_root/edge_happybabytracker-data/_data"
test -f "$src_dir/happybabytracker.db" || { echo "happybabytracker database missing: $src_dir/happybabytracker.db" >&2; exit 1; }
# shellcheck disable=SC2016  # $1-$3 expand in the inner sh
unshare --mount --propagation private -- sh -c 'mount --bind "$1" "$2" && exec setpriv --reuid=10001 --regid=10001 --clear-groups sqlite3 "$2/happybabytracker.db" ".backup '\''$3/happybabytracker.db'\''"' sh "$src_dir" "$mnt" "$snap"
sqlite3 "$snap/happybabytracker.db" 'PRAGMA integrity_check;' | grep -qx ok
mkdir -p "$work/happybabytracker"
mv "$snap/happybabytracker.db" "$work/happybabytracker/"

( cd "$work" && find headscale happybabytracker -type f -print0 | sort -z | xargs -0 sha256sum > MANIFEST.sha256 )
tar -C "$work" -cf - . | age -R /etc/edge-backup/recipients.txt -o "$archive.partial"
mv "$archive.partial" "$archive"
sha256sum "$archive" | sed "s#$out_dir/##" > "$archive.sha256"

rsync -a --chmod=F600 -e "ssh -i /etc/edge-backup/id_ed25519 -o IdentitiesOnly=yes -o BatchMode=yes \
  -o UserKnownHostsFile=/etc/edge-backup/known_hosts -o StrictHostKeyChecking={{ 'yes' if backup_host_known_hosts | default('') else 'accept-new' }}" \
  "$archive" "$archive.sha256" "{{ backup_remote_user }}@{{ backup_tailnet_host }}:{{ backup_remote_path }}/"

find "$out_dir" -name 'edge-*.tar.age*' -mtime +{{ backup_local_retention_days }} -delete
echo "backup ok: $archive"
