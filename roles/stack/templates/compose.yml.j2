# {{ ansible_managed }}
name: edge

x-hardening: &hardening
  restart: unless-stopped
  security_opt: ["no-new-privileges:true"]
  cap_drop: [ALL]
  logging:
    driver: local
    options: {max-size: 10m, max-file: "3"}

services:
  headscale:
    <<: *hardening
    image: {{ headscale_image }}
    command: serve
    read_only: true
    ports:
      - "127.0.0.1:8080:8080"
      - "127.0.0.1:9090:9090"
      - "3478:3478/udp"
    volumes:
      - ./headscale:/etc/headscale:ro
      - headscale-data:/var/lib/headscale
      - headscale-run:/var/run/headscale
    healthcheck:
      test: ["CMD", "headscale", "health"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s

  caddy:
    <<: *hardening
    image: edge-caddy:{{ caddy_version }}-{{ caddy_ratelimit_commit[:12] }}
    build:
      context: ./caddy
      args:
        CADDY_BUILDER_IMAGE: {{ caddy_builder_image }}
        CADDY_RUNTIME_IMAGE: {{ caddy_runtime_image }}
        CADDY_VERSION: "{{ caddy_version }}"
        CADDY_DNS_DESEC_VERSION: {{ caddy_dns_desec_version }}
        CADDY_RATELIMIT_COMMIT: {{ caddy_ratelimit_commit }}
    # Host networking: real client IPs for rate limits and tailnet matching, and a route to 100.64.0.0/10.
    network_mode: host
    cap_add: [NET_BIND_SERVICE]
    env_file: [./caddy/caddy.env]
    volumes:
      - ./caddyfile:/etc/caddy:ro
      - caddy-data:/data
      - caddy-config:/config
      - /var/log/caddy:/var/log/caddy
    depends_on:
      headscale: {condition: service_healthy}
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://127.0.0.1:2019/config/"]
      interval: 30s
      timeout: 5s
      retries: 3

  gatus:
    <<: *hardening
    image: {{ gatus_image }}
    # Host networking: probes reach tailnet peers and 100.100.100.100 directly; web UI bound to 127.0.0.1.
    network_mode: host
    env_file: [./gatus/gatus.env]
    environment:
      GATUS_CONFIG_PATH: /config/config.yaml
    volumes:
      - ./gatus/config.yaml:/config/config.yaml:ro
      - gatus-data:/data
    mem_limit: 128m

  ntfy:
    <<: *hardening
    image: {{ ntfy_image }}
    command: serve
    ports: ["127.0.0.1:2586:2586"]
    volumes:
      - ./ntfy/server.yml:/etc/ntfy/server.yml:ro
      - ntfy-data:/var/lib/ntfy
    mem_limit: 128m
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://127.0.0.1:2586/v1/health"]
      interval: 30s
      timeout: 5s
      retries: 3

  webhooks-mcp:
    <<: *hardening
    image: {{ webhooks_mcp_image }}
    read_only: true
    ports:
      - "127.0.0.1:{{ webhooks_mcp_port }}:9100"
      - "127.0.0.1:{{ webhooks_ingest_port }}:9101"
    env_file: [./webhooks-mcp/webhooks-mcp.env]
    volumes:
      - webhooks-data:/data
    mem_limit: 192m

  # Its own network: nothing else may reach the admin port 9201 or spoof the dashboard's forwarded headers.
  commsgun-api:
    <<: *hardening
    image: {{ commsgun_api_image }}
    read_only: true
    ports: ["127.0.0.1:{{ commsgun_enqueue_port }}:9200"]
    env_file: [./commsgun/api.env]
    volumes:
      - commsgun-data:/data
    networks: [commsgun]
    mem_limit: 96m
    stop_grace_period: 30s

  commsgun-ui:
    <<: *hardening
    image: {{ commsgun_ui_image }}
    read_only: true
    ports: ["127.0.0.1:{{ commsgun_ui_port }}:9202"]
    env_file: [./commsgun/ui.env]
    networks: [commsgun]
    depends_on: [commsgun-api]
    mem_limit: 192m
    healthcheck:
      test: ["CMD", "node", "-e", "fetch('http://127.0.0.1:9202/healthz').then(r => process.exit(r.ok ? 0 : 1), () => process.exit(1))"]
      interval: 30s
      timeout: 5s
      retries: 3

networks:
  commsgun: {}

volumes:
  headscale-data:
  headscale-run:
  caddy-data:
  caddy-config:
  gatus-data:
  ntfy-data:
  webhooks-data:
  commsgun-data:
