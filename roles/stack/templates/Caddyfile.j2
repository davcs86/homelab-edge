# {{ ansible_managed }}
# The only reverse proxy on the edge. Public surface: headscale, plus an allowlist on {{ public_app_hostname }}.
{
	email {{ acme_email }}
{% if acme_ca_url | default('') %}
	acme_ca {{ acme_ca_url }}
{% endif %}
	admin localhost:2019
	servers {
		# UDP/443 is closed at the cloud firewall, so do not advertise HTTP/3.
		protocols h1 h2
	}
	log default {
		output stderr
		format json
		level INFO
		exclude http.log.error.commsgun_ui http.handlers.reverse_proxy
	}
	# These log the full request, and the dashboard's query and Referer carry recipient addresses; reverse_proxy is not per host.
	log redacted_requests {
		output stderr
		format filter {
			request>uri regexp \?.* ""
			request>headers>Referer delete
			wrap json
		}
		level INFO
		include http.log.error.commsgun_ui http.handlers.reverse_proxy
	}
}

# DNS-01 through the deSEC-delegated {{ acme_zone }} zone; Cloudflare holds CNAMEs _acme-challenge.<name> -> <label>.{{ acme_zone }}.
(acme) {
{% if caddy_test_mode | default(false) %}
	tls internal
{% else %}
	tls {
		dns desec {
			token {env.DESEC_TOKEN}
		}
		dns_challenge_override_domain {args[0]}
		# deSEC's anycast nodes converge after Caddy's own check passes; an early multi-perspective lookup
		# returns NXDOMAIN, which resolvers then cache for the zone's negative TTL (300s) and every retry fails.
		propagation_delay 2m
		propagation_timeout 10m
	}
{% endif %}
}

(access_log) {
	log {
		output file /var/log/caddy/{args[0]}.access.log {
			roll_size 50MiB
			roll_keep 5
			roll_keep_for 720h
		}
		format filter {
			# OAuth parameters are single-use but still credentials while in flight.
			request>uri query {
				delete code
				delete state
				delete txn
				delete agent_cb
				delete code_verifier
			}
			wrap json
		}
	}
}

# Must be the first handle in its scope: `handle` blocks with non-path matchers run in written order.
(tailnet_only) {
	@outside_tailnet not remote_ip {{ tailnet_v4_prefix }} {{ tailnet_v6_prefix }}
	handle @outside_tailnet {
		abort
	}
}

# Tailnet grants are per port, so staging may reach 443; Caddy keeps it off every site except its own. First handle in its scope.
(deny_staging_vm) {
{% if staging_vm_ips | length > 0 %}
	@staging_vm remote_ip {{ staging_vm_ips | join(' ') }}
	handle @staging_vm {
		abort
	}
{% else %}
	# No staging VM registered with headscale yet (see the deploy output).
{% endif %}
}

(app_ui) {
	reverse_proxy {args[0]}:{{ app_ui_port }} {
		transport http {
			resolvers 100.100.100.100
		}
	}
}

# The agent's routes are root-relative; DO App Platform stripped /agent too.
(agent) {
	uri strip_prefix /agent
	reverse_proxy {args[0]}:{{ app_agent_port }} {
		flush_interval -1
		transport http {
			resolvers 100.100.100.100
		}
	}
}

# Internet-facing routes shared by every `app` site: per-IP rate limits, body caps, MCP + OAuth + login.
# args: upstream host, site label (zone names are global, so each site needs its own).
(public_routes) {
	rate_limit {
		zone {args[1]}_general {
			key {remote_host}
			window {{ ratelimit.general.window }}
			events {{ ratelimit.general.events }}
			ipv6_prefix 64
		}
		zone {args[1]}_mcp {
			match {
				path /agent /agent/
			}
			key {remote_host}
			window {{ ratelimit.mcp.window }}
			events {{ ratelimit.mcp.events }}
			ipv6_prefix 64
		}
		zone {args[1]}_oauth {
			match {
				path /agent/oauth/authorize /agent/oauth/callback /agent/oauth/token
			}
			key {remote_host}
			window {{ ratelimit.oauth.window }}
			events {{ ratelimit.oauth.events }}
			ipv6_prefix 64
		}
		zone {args[1]}_register {
			match {
				path /agent/oauth/register
			}
			key {remote_host}
			window {{ ratelimit.register.window }}
			events {{ ratelimit.register.events }}
			ipv6_prefix 64
		}
		# Login has no lockout or MFA upstream; these two zones are the only brute-force control.
		zone {args[1]}_login {
			match {
				method POST
				path /api/auth/login
			}
			key {remote_host}
			window {{ ratelimit.login.window }}
			events {{ ratelimit.login.events }}
			ipv6_prefix 64
		}
		zone {args[1]}_login_hourly {
			match {
				method POST
				path /api/auth/login
			}
			key {remote_host}
			window {{ ratelimit.login_hourly.window }}
			events {{ ratelimit.login_hourly.events }}
			ipv6_prefix 64
		}
	}

	# TODO(verify): restrict the MCP + token endpoints to Anthropic's egress ranges once published
	# (sketch in docs/decisions.md).

	@mcp path /agent /agent/
	handle @mcp {
		request_body {
			max_size {{ body_limits.mcp }}
		}
		import agent {args[0]}
	}

	@agent_meta path /agent/.well-known/oauth-protected-resource /agent/.well-known/oauth-authorization-server
	handle @agent_meta {
		import agent {args[0]}
	}

	@agent_register path /agent/oauth/register
	handle @agent_register {
		request_body {
			max_size {{ body_limits.register }}
		}
		import agent {args[0]}
	}

	@agent_oauth path /agent/oauth/authorize /agent/oauth/callback /agent/oauth/token
	handle @agent_oauth {
		request_body {
			max_size {{ body_limits.default }}
		}
		import agent {args[0]}
	}

	@root_meta path /.well-known/oauth-protected-resource/agent /.well-known/oauth-authorization-server/agent
	handle @root_meta {
		import app_ui {args[0]}
	}

	@login_page {
		method GET HEAD
		path /auth/oauth-login
	}
	handle @login_page {
		import app_ui {args[0]}
	}

	@login_api {
		method POST
		path /api/auth/login
	}
	handle @login_api {
		request_body {
			max_size {{ body_limits.login }}
		}
		import app_ui {args[0]}
	}

	@ui_health {
		method GET HEAD
		path /trader/api/health
	}
	handle @ui_health {
		import app_ui {args[0]}
	}

	@assets {
		method GET HEAD
		path /_next/static/* /sw.js /manifest.webmanifest /icon-192.png /icon-512.png /icon-512-maskable.png /icon.svg
	}
	handle @assets {
		import app_ui {args[0]}
	}
}

{{ headscale_hostname }} {
	import acme hs.{{ acme_zone }}
	import access_log headscale
	import deny_staging_vm

	# headscale's HTTP API needs an API key, but it has no reason to be reachable from the internet.
	@admin_api path /api/* /swagger*
	handle @admin_api {
		import tailnet_only
		reverse_proxy 127.0.0.1:8080
	}

	handle {
		reverse_proxy 127.0.0.1:8080 {
			flush_interval -1
		}
	}
}

{% for site in edge_sites %}
{% if site.kind == 'app' %}
{{ site.hostname }} {
	import acme {{ site.name }}.{{ acme_zone }}
	import access_log {{ site.name }}
{% if site.isolate_staging_vm | default(true) %}
	import deny_staging_vm
{% endif %}

	# Tailnet clients reach this name via the split-horizon extra record and get the full app.
	@tailnet remote_ip {{ tailnet_v4_prefix }} {{ tailnet_v6_prefix }}
	handle @tailnet {
		@agent_any path /agent /agent/*
		handle @agent_any {
			import agent {{ site.upstream }}
		}
		handle {
			import app_ui {{ site.upstream }}
		}
	}

{% if site.ui_public | default(false) %}
	# Internet: the whole UI plus the MCP/OAuth set from public_routes. Other /agent paths (incl. the unauthenticated /api/tools) stay tailnet-only.
	handle {
		import public_routes {{ site.upstream }} {{ site.name }}

		@agent_rest path /agent /agent/*
		handle @agent_rest {
			respond "Not Found" 404
		}
		handle {
			import app_ui {{ site.upstream }}
		}
	}
{% else %}
	# Internet: MCP endpoint + Claude.ai OAuth login only. Everything else is 404.
	handle {
		import public_routes {{ site.upstream }} {{ site.name }}

		handle {
			respond "Not Found" 404
		}
	}
{% endif %}
}

{% elif site.kind == 'bearer_mcp' %}
{{ site.hostname }} {
	import acme {{ site.name }}.{{ acme_zone }}
	import access_log {{ site.name }}
	import deny_staging_vm

	# Only {{ site.path }} is public; any other listener on the same container is tailnet-only.
	@mcp path {{ site.path }}
	handle @mcp {
		rate_limit {
			zone {{ site.limits }} {
				key {remote_host}
				window {{ ratelimit[site.limits].window }}
				events {{ ratelimit[site.limits].events }}
				ipv6_prefix 64
			}
		}
		request_body {
			max_size {{ body_limits[site.limits] }}
		}
		reverse_proxy 127.0.0.1:{{ site.port }} {
			flush_interval -1
		}
	}

	handle {
		respond "Not Found" 404
	}
}

{% endif %}
{% endfor %}
*.{{ magicdns_base_domain }} {
	import acme ts.{{ acme_zone }}
	import access_log tailnet
	import deny_staging_vm
	import tailnet_only

	@status host {{ status_hostname }}
	handle @status {
		reverse_proxy 127.0.0.1:{{ gatus_port }}
	}

	@ntfy host {{ ntfy_hostname }}
	handle @ntfy {
		reverse_proxy 127.0.0.1:2586 {
			flush_interval -1
		}
	}

	@webhooks_ingest host {{ webhooks_ingest_hostname }}
	handle @webhooks_ingest {
		request_body {
			max_size {{ body_limits.webhooks_ingest }}
		}
		reverse_proxy 127.0.0.1:{{ webhooks_ingest_port }}
	}

	@commsgun_enqueue host {{ commsgun_enqueue_hostname }}
	handle @commsgun_enqueue {
		request_body {
			max_size {{ body_limits.commsgun_enqueue }}
		}
		reverse_proxy 127.0.0.1:{{ commsgun_enqueue_port }}
	}

	# The dashboard keeps recipient addresses in its query (and so in Referer and redirects); its own logger drops all three.
	log commsgun_ui {
		hostnames {{ commsgun_ui_hostname }}
		output file /var/log/caddy/commsgun-ui.access.log {
			roll_size 50MiB
			roll_keep 5
			roll_keep_for 720h
		}
		format filter {
			request>uri regexp \?.* ""
			request>headers>Referer delete
			resp_headers>Location delete
			wrap json
		}
	}
	# The dashboard derives its origin and login rate-limit key from Caddy's default X-Forwarded-*; do not strip them.
	@commsgun_ui host {{ commsgun_ui_hostname }}
	handle @commsgun_ui {
		reverse_proxy 127.0.0.1:{{ commsgun_ui_port }}
	}

	handle {
		respond "Not Found" 404
	}
}

# Tailnet-only (not in the cloud firewall): the staging environment's webhooks ingest, reached on its own port so staging never needs 443 for it.
*.{{ magicdns_base_domain }}:{{ staging_edge_port }} {
	import acme ts.{{ acme_zone }}
	import access_log staging

	@webhooks_ingest host {{ webhooks_ingest_hostname }}
	handle @webhooks_ingest {
		import tailnet_only
		request_body {
			max_size {{ body_limits.webhooks_ingest }}
		}
		reverse_proxy 127.0.0.1:{{ webhooks_ingest_port }}
	}

	handle {
		respond "Not Found" 404
	}
}
