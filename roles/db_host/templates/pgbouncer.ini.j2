; Managed by Ansible (roles/db_host).
[databases]
{% for w in db_workloads %}
{{ w.database }} = host=127.0.0.1 port=5432 dbname={{ w.database }} pool_size={{ db_pgbouncer_pool_size }}
{% endfor %}

[pgbouncer]
listen_addr = 127.0.0.1,{{ db_tailnet_ipv4 }}
listen_port = 6432
unix_socket_dir = /var/run/postgresql
pidfile = /var/run/postgresql/pgbouncer.pid
logfile = /var/log/postgresql/pgbouncer.log
auth_type = scram-sha-256
auth_file = /etc/pgbouncer/userlist.txt
pool_mode = transaction
max_client_conn = 200
default_pool_size = {{ db_pgbouncer_pool_size }}
max_prepared_statements = 100
ignore_startup_parameters = extra_float_digits
client_tls_sslmode = require
client_tls_cert_file = {{ db_tls_dir }}/server.crt
client_tls_key_file = {{ db_tls_dir }}/server.key
